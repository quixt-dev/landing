{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quixt-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "quixt.dev", "custom_domain": true },
    { "pattern": "www.quixt.dev", "custom_domain": true }
  ],
  "vars": {
    "INBOX": "lexifyrtechnologies@gmail.com",
    "SENDER": "website@quixt.dev",
    "CAL_USERNAME": "quixt",
    "CAL_EVENT": "discovery"
  },
  // No destination allow-list: the Aster support auto-responder mails the visitor who filled in the form.
  // Senders stay locked to SENDER, and /api/* is rate limited and honeypot-protected.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["website@quixt.dev"] }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
