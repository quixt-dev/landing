---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/ui/Button.astro';
---
<BaseLayout title="Message Received" description="Thanks for reaching out to Quixt. A real person will reply within 24 hours." noindex>
  <section class="container ty">
    <p class="eyebrow">Contact · Sent</p>
    <h1 class="h1">Got It.<br />Your Idea Is With Us.</h1>
    <p class="lead">A Real Person Will Read It And Reply Within 24 Hours, Usually Much Sooner. Keep An Eye On Your Inbox, And Your Spam Folder Just In Case.</p>
    <div class="btns"><Button href="/projects/" variant="solid">See Our Work</Button><Button href="/">Back To Home</Button></div>
  </section>
</BaseLayout>
<style>
  .ty { padding-block: clamp(80px, 12vw, 180px) 40px; display: grid; gap: 22px; justify-items: start; }
  .lead { max-width: 60ch; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
</style>
