---
import { graphicSrc } from '../../lib/graphics/registry';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { projects } from '../../data/projects';
import { graph, organization, website, webPage, breadcrumbs, abs } from '../../lib/schema';

const path = '/projects/';
const title = 'Case Studies · AI Products & Landing Pages Built By Quixt';
const description = 'Quixt case studies: Tessa (AI marketing), NandyAI (society management), Flowgentic (multi-agent AI) and the Infinify studio site.';
const jsonLd = graph(
  organization(), website(),
  webPage({ path, title, description, type: 'CollectionPage', breadcrumbs: true }),
  breadcrumbs(path, [{ name: 'Home', path: '/' }, { name: 'Projects', path }]),
  { '@type': 'ItemList', '@id': `${abs(path)}#list`, itemListElement: projects.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, description: p.summary, url: abs(`/projects/${p.slug}/`) })) },
);
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="container list-hero">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Projects' }]} />
    <SectionHeader level="h1" eyebrow="Selected Work" title={'AI Products\nI’ve Shipped'} lead="Agent Platforms, AI SaaS And Launch Pages, Each Designed And Built End To End. Open Any Card For The Architecture, Stack And Code." />
  </section>
  <section class="container list" aria-label="All projects">
    {projects.map((p, i) => (
      <article class:list={['proj', i % 2 && 'proj--alt']} id={p.slug}>
        <img data-inline-art="card" src={graphicSrc(`product-${p.slug}`)} width="524" height="264" alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        <div class="proj__copy">
          <p class="eyebrow">{p.category} · {p.year}</p>
          <h2 class="proj__name">{p.name}</h2>
          <p class="lead">{p.summary}</p>
          <p class="role">{p.caseStudy.role}</p>
          <Button href={`/projects/${p.slug}/`} variant="solid">Read The Case Study &nbsp;→</Button>
        </div>
      </article>
    ))}
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .list-hero { padding-top: clamp(40px, 4.2vw, 64px); padding-top: round(clamp(40px, 4.2vw, 64px), 8px); display: grid; gap: 48px; }
  .list { margin-top: 72px; display: grid; gap: 16px; }
  .proj { display: grid; gap: 24px; background: var(--cream); padding: 16px; align-items: center; }
  .proj img { width: 100%; height: auto; }
  .proj__copy { display: grid; gap: 16px; justify-items: start; padding: 12px; }
  .proj__name { font-size: clamp(2.5rem, 5vw, 4.5rem); letter-spacing: var(--track-xl); word-spacing: var(--words-xl); line-height: 1.1; }
  .role { font-size: var(--fs-small); color: var(--brand-ink); }
  .soon { font-weight: 500; font-size: var(--fs-small); padding: 12px 16px; border: 1.5px dashed var(--line); }
  @media (min-width: 1000px) { .proj { grid-template-columns: 524px 1fr; gap: 48px; } .proj--alt { grid-template-columns: 1fr 524px; } .proj--alt img { order: 2; } }
</style>
