---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import HeroMedia from '../components/home/HeroMedia.astro';
import Services from '../components/home/Services.astro';
import Process from '../components/home/Process.astro';
import Products from '../components/home/Products.astro';
import Pricing from '../components/home/Pricing.astro';
import Founder from '../components/home/Founder.astro';
import FAQ from '../components/home/FAQ.astro';
import { site } from '../data/site';
import { services, pricing, faqs } from '../data/home';
import { graph, organization, founderPerson, website, webPage, serviceCatalog, faqPage } from '../lib/schema';

const title = 'Quixt · Landing Pages & MVPs For AI Startups';
const description = 'Quixt is a one-person studio building landing pages (from $1,499) and MVPs (from $3,499) for AI and agent-infra startups. Fixed prices, weekly demos, code you own.';
const jsonLd = graph(
  organization(),
  founderPerson(),
  website(),
  webPage({ path: '/', title, description, image: site.ogImage }),
  serviceCatalog(services, pricing.plans),
  faqPage('/', faqs),
);
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Hero />
  <About />
  <HeroMedia />
  <Services />
  <Process />
  <Products />
  <Founder />
  <Pricing />
  <FAQ items={faqs} />
</BaseLayout>
