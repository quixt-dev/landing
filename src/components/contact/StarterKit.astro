---
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<section class="section container" aria-labelledby="kit-title">
  <div class="kit dot-grid--brand">
    <div class="kit__copy" data-stagger data-each=".1">
      <p class="eyebrow">05 · Free Starter Kit</p>
      <h2 id="kit-title" class="kit__title">Not Ready To Talk Yet?<br />Start With A One-Page Brief.</h2>
      <p class="lead">A Fill-In-The-Blanks Template That Helps You Think Through Your Idea, The Same One We Use With Every Client. Takes About 15 Minutes.</p>
      <div class="kit__btns">
        <Button href="/downloads/quixt-product-brief.pdf" variant="solid" download>Download Free Brief (PDF) &nbsp;↓</Button>
        <Button href="/downloads/quixt-product-brief-example.pdf">See A Filled Example</Button>
      </div>
    </div>
    <div class="kit__art" aria-hidden="true">
      <div class="page page--back"></div>
      <div class="page page--front">
        <p class="p__h">Product Brief</p><p class="p__s">{site.name} Starter Kit · v2</p>
        <p class="p__q">01 &nbsp;The Problem</p><p class="p__hint">What Frustrates Your Future Users?</p><i class="ln"></i><i class="ln ln--s"></i>
        <p class="p__q">02 &nbsp;Who It’s For</p><p class="p__hint">Describe One Real Person</p><i class="ln"></i><i class="ln ln--s"></i>
        <p class="p__q">03 &nbsp;Must-Have Features</p>
        <p class="p__c on">Sign Up / Log In</p><p class="p__c on">Book A Walker</p><p class="p__c">Pay In The App</p>
        <p class="p__q">04 &nbsp;Budget & Timeline</p><p class="p__pills"><span>$15K – $40K</span><span>1 – 3 Months</span></p>
      </div>
      <p class="stamp"><strong>FREE</strong><span>15 Min</span></p>
    </div>
  </div>
</section>
<style>
  .kit { position: relative; overflow: hidden; background-color: var(--cream); display: grid; gap: 40px; padding: clamp(32px, 4.4vw, 64px) clamp(24px, 4.4vw, 56px); }
  .kit__copy { display: grid; gap: 20px; justify-items: start; align-content: center; }
  .kit__title { font-size: clamp(1.8rem, 3.1vw, 2.5rem); line-height: 1.22; letter-spacing: var(--track-l); word-spacing: var(--words-l); }
  .kit .lead { max-width: 35rem; }
  .kit__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; }
  .kit__art { position: relative; height: 440px; }
  .page--front { animation: float 7s ease-in-out infinite; }
  .page--back { animation: float 7s ease-in-out -3.5s infinite; }
  .stamp { animation: spin-slow 18s linear infinite; }
  @keyframes float { 50% { translate: 0 -10px; } }
  @keyframes spin-slow { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .page--front, .page--back, .stamp { animation: none; } }
  .kit__art :global(.p__c.on)::before { animation: tick .5s cubic-bezier(.34,1.56,.64,1) both; }
  @keyframes tick { from { transform: scale(0); } }
  .page { position: absolute; background: var(--white); border: 1px solid var(--line); }
  .page--back { width: 330px; height: 400px; left: 60px; top: 30px; transform: rotate(-6deg); }
  .page--front { width: 340px; height: 420px; left: 0; top: 10px; transform: rotate(3deg); padding: 30px 28px; box-shadow: 0 18px 40px -6px rgb(140 56 0 / .12); border-top: 6px solid var(--brand); font-size: 0.72rem; }
  .p__h { font-family: var(--font-display); font-size: 1.375rem; letter-spacing: var(--track-m); word-spacing: var(--words-m); }
  .p__s { color: var(--brand-ink); font-size: 0.66rem; margin-bottom: 18px; }
  .p__q { font-weight: 500; margin-top: 14px; }
  .p__hint { color: var(--brand-ink); font-size: 0.68rem; }
  .ln { display: block; height: 1px; background: rgb(171 66 0 / .3); margin-top: 16px; width: 100%; }
  .ln--s { width: 70%; background: rgb(171 66 0 / .2); }
  .p__c { display: flex; gap: 8px; align-items: center; margin-top: 6px; font-size: 0.68rem; }
  .p__c::before { content: ''; width: 10px; height: 10px; border: 1px solid rgb(171 66 0 / .6); }
  .p__c.on::before { background: var(--brand); }
  .p__pills { display: flex; gap: 8px; margin-top: 8px; }
  .p__pills span { padding: 4px 8px; border: 1px solid rgb(171 66 0 / .4); font-weight: 500; font-size: 0.66rem; }
  .stamp { position: absolute; left: 290px; bottom: 10px; width: 86px; height: 86px; border-radius: 50%; background: var(--brand); color: var(--white); display: grid; place-content: center; text-align: center; transform: rotate(-12deg); box-shadow: 0 0 0 5px var(--cream), 0 0 0 6.5px rgb(171 66 0 / .6); }
  .stamp strong { font-family: var(--font-display); font-weight: 500; font-size: 0.94rem; }
  .stamp span { font-size: 0.62rem; }
  @media (min-width: 1000px) { .kit { grid-template-columns: 1fr 440px; min-height: 460px; } .kit__art { height: auto; min-height: 450px; } }
  @media (max-width: 480px) { .kit__art { transform: scale(.82); transform-origin: left top; height: 380px; } }
  @media (max-width: 600px) { .kit { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
