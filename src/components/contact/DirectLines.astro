---
import { site } from '../../data/site';
import { contactIcons } from '../../lib/graphics/icons';
import Icon from '../ui/Icon.astro';
const lines = [
  { key: 'email', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { key: 'phone', label: 'Call', value: site.phone, href: `tel:${site.phoneHref}` },
  { key: 'whatsapp', label: 'WhatsApp', value: 'Chat With Me, Replies In Minutes', href: site.whatsapp },
  // Office is plain text on purpose: no map link.
  { key: 'office', label: 'Office', value: `${site.address.street}, ${site.address.locality} · Mon–Fri` },
] as { key: string; label: string; value: string; href?: string }[];
---
<section class="dl" aria-labelledby="dl-title">
  <h3 id="dl-title" class="dl__title">Or Reach Me Directly</h3>
  <address>
    <ul role="list">
      {lines.map((l) => (
        <li>{l.href ? (
          <a class="row" href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            <span class="ic"><Icon paths={contactIcons[l.key]} size={20} viewBox={20} stroke={1.4} /></span>
            <span class="tx"><span class="lb">{l.label}</span><span class="vl">{l.value}</span></span>
            <span aria-hidden="true" class="ar">↗</span>
          </a>
        ) : (
          <div class="row">
            <span class="ic"><Icon paths={contactIcons[l.key]} size={20} viewBox={20} stroke={1.4} /></span>
            <span class="tx"><span class="lb">{l.label}</span><span class="vl">{l.value}</span></span>
          </div>
        )}</li>
      ))}
    </ul>
  </address>
</section>
<style>
  .dl { background: var(--cream); padding: 32px 32px 12px; }
  .dl__title { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); margin-bottom: 16px; }
  address { font-style: normal; }
  .row { display: grid; grid-template-columns: 40px 1fr auto; align-items: center; gap: 16px; padding: 16px 0; border-top: 1.5px solid var(--line-soft); }
  .ic { width: 40px; height: 40px; display: grid; place-items: center; background: var(--white); border: 1px solid var(--line); }
  .tx { display: grid; gap: 4px; min-width: 0; }
  .lb { font-size: 0.72rem; color: var(--brand-ink); }
  .vl { font-weight: 500; font-size: 0.875rem; overflow-wrap: anywhere; }
  li a:hover .vl { text-decoration: underline; text-underline-offset: 3px; }
  .ar { font-size: 1rem; transition: transform .45s cubic-bezier(.16,1,.3,1); }
  li a:hover .ar { transform: translate(4px, -4px); }
  .ic { transition: background-color .35s, color .35s, transform .5s cubic-bezier(.34,1.56,.64,1); }
  li a:hover .ic { background: var(--brand); color: var(--white); }
  @media (max-width: 600px) { .dl { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
