---
import Lines from '../ui/Lines.astro';
import CornerBrackets from '../ui/CornerBrackets.astro';
import { nextSteps } from '../../data/contact';
import { pad2 } from '../../lib/text';
---
<section class="section container" aria-labelledby="next-title">
  <div class="panel on-brand dot-grid">
    <CornerBrackets color="#fff" inset={24} size={36} />
    <header class="head">
      <div class="head__main"><p class="eyebrow" data-scramble>02 · What Happens Next</p><h2 id="next-title" class="h2" data-split><Lines text={'From Hello To Kick-Off\nIn About A Week'} /></h2></div>
      <p class="lead" data-reveal data-delay=".2">No Sales Pressure And No Homework. Here’s Exactly What To Expect After You Hit Send.</p>
    </header>
    <ol class="steps" role="list" data-timeline="x">
      <span class="steps__fill" data-timeline-fill aria-hidden="true"></span>
      {nextSteps.map((s, i) => (
        <li class="step" data-timeline-step>
          <p class="when">{s.when}</p>
          <span class:list={['mk', i === 0 && 'mk--on']} aria-hidden="true"></span>
          <p class="n" aria-hidden="true">{pad2(i + 1)}</p>
          <h3>{s.title}</h3>
          <p class="text">{s.text}</p>
          <p class="you"><span>You Do:</span> {s.youDo}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .panel { position: relative; background-color: var(--brand); padding: clamp(40px, 5.6vw, 80px) clamp(16px, 5vw, 72px) clamp(40px, 5vw, 64px); padding: round(clamp(40px, 5.6vw, 80px), 8px) round(clamp(16px, 5vw, 72px), 8px) round(clamp(40px, 5vw, 64px), 8px); }
  .head { display: grid; gap: 24px; }
  .head__main { display: grid; gap: 16px; }
  .head .lead { max-width: 27rem; }
  .steps { position: relative; margin-top: clamp(48px, 6vw, 88px); margin-top: round(clamp(48px, 6vw, 88px), 8px); display: grid; gap: 40px; }
  .step { display: grid; gap: 8px; align-content: start; position: relative; padding-left: 32px; }
  .step::before { content: ''; position: absolute; left: 6px; top: 0; bottom: -40px; border-left: 1.5px solid rgb(255 255 255 / .25); }
  .step:last-child::before { bottom: 0; }
  .when { font-weight: 500; font-size: 0.8125rem; color: var(--on-brand-muted); }
  .mk { z-index: 2; position: absolute; left: 0; top: 4px; width: 14px; height: 14px; background: var(--brand); border: 1.5px solid var(--white); }
  .mk--on, .step.is-active .mk { background: var(--white); }
  .mk { transition: background-color .4s, transform .6s cubic-bezier(.34,1.56,.64,1), box-shadow .6s; }
  .step.is-active .mk { transform: rotate(45deg); box-shadow: 0 0 0 6px rgb(255 255 255 / .2); }
  .step h3, .text, .you, .n { transition: opacity .8s, transform .8s cubic-bezier(.16,1,.3,1); }
  :global(.motion) .step:not(.is-active) :is(h3, .text, .you, .n) { transform: translateY(14px); }
  .steps__fill { position: absolute; left: 6px; top: 0; bottom: 0; width: 1.5px; background: var(--white); transform-origin: 50% 0; transform: scaleY(var(--p, 1)); z-index: 1; }
  .n { font-size: 0.8125rem; color: var(--on-brand-muted); margin-top: 8px; }
  .step h3 { font-size: 1.5rem; line-height: 1.25; letter-spacing: var(--track-m); word-spacing: var(--words-m); }
  .text { font-size: 0.875rem; line-height: 1.64; color: var(--on-brand-muted); max-width: 16rem; }
  .you { justify-self: start; margin-top: 12px; padding: 8px 8px; background: rgb(255 255 255 / .12); border: 1px solid rgb(255 255 255 / .3); font-size: 0.75rem; font-weight: 500; }
  .you span { font-weight: 400; color: var(--on-brand-muted); }
  @media (min-width: 1000px) {
    .head { grid-template-columns: 1fr minmax(0, 27rem); } .head__main { grid-column: 1 / -1; grid-row: 1; } .head .lead { grid-column: 2; grid-row: 1; align-self: end; justify-self: end; margin-bottom: 8px; }
    .steps { grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 40px; border-top: 1.5px solid rgb(255 255 255 / .25); }
    .steps__fill { left: 0; right: 0; top: 40px; bottom: auto; width: auto; height: 1.5px; transform-origin: 0 50%; transform: scaleX(var(--p, 1)); }
    .step { padding-left: 0; grid-template-rows: auto 30px auto auto 1fr auto; }
    .step::before { display: none; }
    .mk { position: relative; top: 0; margin-top: 2px; }
  }
  @media (max-width: 600px) { .panel { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
