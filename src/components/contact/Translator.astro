---
import SectionHeader from '../ui/SectionHeader.astro';
import TagList from '../ui/TagList.astro';
import { translations } from '../../data/contact';
---
<section class="section container" aria-labelledby="tr-title">
  <SectionHeader id="tr-title" eyebrow="03 · Not Sure What To Ask For?" title={'Describe The Outcome.\nI’ll Name The Build.'} lead="Most AI Products Start As One Sentence. Here’s How A Few Typical Ones Map To A Package." />
  <table class="tr">
    <caption class="visually-hidden">Examples of founder requests and the Quixt package that fits each, with typical timelines and starting prices</caption>
    <thead><tr><th scope="col">You Say</th><th scope="col" aria-hidden="true"></th><th scope="col">I Build</th><th scope="col">Typical Scope</th></tr></thead>
    <tbody data-stagger data-each=".1">
      {translations.map((t) => (
        <tr class:list={[t.featured && 'is-hot']}>
          <th scope="row" class="say">“{t.say}”</th>
          <td class="arrow" aria-hidden="true"><svg width="60" height="14" viewBox="0 0 60 14" fill="none"><path d="M0 7H52M50 1L58 7L50 13" stroke="currentColor" stroke-width="1.5"/></svg></td>
          <td><TagList tags={t.build} tone={t.featured ? 'on-brand' : 'light'} /></td>
          <td class="scope"><strong>{t.weeks}</strong><span>{t.from}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="note">Estimates Are Indicative. Your Quote Will Always Have A Fixed, Exact Price.</p>
</section>
<style>
  .tr { margin-top: 56px; width: 100%; border-collapse: separate; border-spacing: 0 12px; }
  thead th { text-align: left; font-weight: 500; font-size: var(--fs-xs); color: var(--brand-ink); padding: 0 32px 2px; }
  tbody tr { background: var(--cream); transition: background-color .5s cubic-bezier(.16,1,.3,1), color .35s; }
  tbody tr:not(.is-hot):hover { background: var(--cream-2); }
  .arrow svg { transition: transform .6s cubic-bezier(.16,1,.3,1); }
  tbody tr:hover .arrow svg { transform: translateX(10px); }
  tbody tr :global(.tag) { transition: transform .45s cubic-bezier(.34,1.56,.64,1); }
  tbody tr:hover :global(.tag) { transform: translateY(-3px); }
  tbody tr:hover :global(.tag:nth-child(2)) { transition-delay: .04s; } tbody tr:hover :global(.tag:nth-child(3)) { transition-delay: .08s; } tbody tr:hover :global(.tag:nth-child(4)) { transition-delay: .12s; }
  tbody tr.is-hot { background: var(--brand); color: var(--white); }
  td, tbody th { padding: 32px; vertical-align: middle; }
  .say { text-align: left; font-family: var(--font-display); font-weight: 400; font-size: clamp(1.1rem, 1.5vw, 1.3125rem); line-height: 1.43; letter-spacing: -0.01em; width: 34%; }
  .arrow { width: 60px; padding-inline: 0; }
  .scope { width: 190px; }
  .scope strong { display: block; font-family: var(--font-display); font-weight: 400; font-size: 1.375rem; }
  .scope span { font-size: 0.8125rem; color: var(--brand-ink); }
  .is-hot .scope span { color: var(--on-brand-muted); }
  .note { font-size: var(--fs-xs); color: var(--brand-ink); }
  @media (max-width: 900px) {
    .tr, .tr tbody, .tr tr, .tr td, .tr th { display: block; width: auto; }
    .tr thead, .arrow { display: none; }
    .tr tbody { display: grid; gap: 12px; }
    .tr tr { padding: 24px; display: grid; gap: 16px; }
    .tr td, .tr tbody th { padding: 0; }
  }
  @media (max-width: 600px) { .tr tr { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
