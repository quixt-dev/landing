---
import type { Project, CaseStudy } from '../../data/projects';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import Button from '../ui/Button.astro';
import SpecSheet from './SpecSheet.astro';
export interface Props { project: Project; cs: CaseStudy }
const { project, cs } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const built = cs.published.slice(0, 7) === cs.updated.slice(0, 7) ? `Released ${fmt(cs.published)}` : `Built ${fmt(cs.published)} – ${fmt(cs.updated)}`;
const ext = cs.liveUrl ?? cs.repoUrl;
---
<section class="phero container" aria-labelledby="project-title">
  <div class="phero__crumbs" data-reveal="load" data-delay=".05">
    <Breadcrumbs back={{ label: 'Back To Projects', href: '/projects/' }} items={[{ name: 'Projects', href: '/projects/' }, { name: project.category, href: '/projects/' }, { name: project.name }]} />
    {ext ? <a class="chip" href={ext} target="_blank" rel="noopener"><span class="chip__dot" aria-hidden="true"></span>{cs.status}</a> : <p class="chip"><span class="chip__dot" aria-hidden="true"></span>{cs.status}</p>}
  </div>
  <div class="phero__row">
    <div class="phero__title">
      <p class="eyebrow" data-scramble="load">Case Study · {cs.caseNo} / {project.category}</p>
      <h1 id="project-title" class="display" data-split="load" data-split-type="chars" data-delay=".15">{project.name}</h1>
    </div>
    <div class="phero__intro" data-reveal="load" data-delay=".5">
      <p class="lead">{cs.intro}</p>
      <div class="phero__ctas">
        {cs.liveUrl && <Button href={cs.liveUrl} variant="solid" external>Visit Live Site&nbsp; ↗</Button>}
        {cs.repoUrl && <Button href={cs.repoUrl} variant="solid" external>View On GitHub&nbsp; ↗</Button>}
        <Button href="#architecture">View Architecture</Button>
      </div>
      <p class="phero__dates">{cs.role} · <time datetime={cs.published}>{built}</time></p>
    </div>
  </div>
  <SpecSheet specs={cs.specs} />
</section>
<style>
  .phero { padding-top: clamp(40px, 4.2vw, 60px); }
  .phero__crumbs { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
  .chip:is(a):hover { border-color: var(--brand); }
  .chip { transition: border-color .3s; display: inline-flex; align-items: center; gap: 10px; padding: 9px 14px; border: 1.5px solid var(--line); font-weight: 500; font-size: 0.8125rem; }
  .chip__dot { width: 8px; height: 8px; background: var(--brand); animation: live 1.8s ease-in-out infinite; }
  @keyframes live { 50% { opacity: .25; transform: scale(.6); } }
  @media (prefers-reduced-motion: reduce) { .chip__dot { animation: none; } }
  .phero__row { margin-top: clamp(32px, 3.4vw, 48px); display: grid; gap: 32px; }
  .display { font-size: var(--fs-display); line-height: 1.09; letter-spacing: var(--track-display); word-spacing: var(--words-display); margin-top: 6px; }
  .phero__intro { display: grid; gap: 26px; max-width: 30rem; }
  .phero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .phero__dates { font-size: var(--fs-xs); color: var(--brand-ink); }
  @media (min-width: 1000px) { .phero__row { grid-template-columns: 1fr auto; align-items: end; } .phero__intro { padding-bottom: 22px; } }
</style>
