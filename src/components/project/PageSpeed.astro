---
/** Lighthouse / PageSpeed Insights scores for the live product, as animated ring gauges. */
import SectionHeader from '../ui/SectionHeader.astro';
const { scores, url, name } = Astro.props as { scores: { performance: number; accessibility: number; bestPractices: number; seo: number }; url?: string; name: string };
const items = [['Performance', scores.performance], ['Accessibility', scores.accessibility], ['Best Practices', scores.bestPractices], ['SEO', scores.seo]] as const;
const r = 52, C = 2 * Math.PI * r;
const host = url ? new URL(url).host : '';
---
<section class="section container" aria-labelledby="speed-title">
  <SectionHeader id="speed-title" eyebrow="06 · PageSpeed" title={'Fast, Accessible,\nFound In Search'} lead={`Google PageSpeed Insights Scores For ${host || name}: Speed, Accessibility And SEO Engineered In From Day One.`} />
  <div class="ps">
    <ul class="ps__gauges" role="list" data-stagger data-each=".1">
      {items.map(([label, v]) => (
        <li class="g">
          <span class="g__ring">
            <svg width="128" height="128" viewBox="0 0 128 128" fill="none" aria-hidden="true">
              <circle cx="64" cy="64" r={r} stroke="#AB4200" stroke-opacity=".14" stroke-width="7" />
              <circle data-gauge={v} cx="64" cy="64" r={r} stroke="#AB4200" stroke-width="7" stroke-dasharray={`${(C * v) / 100} ${C}`} transform="rotate(-90 64 64)" />
            </svg>
            <span class="g__v" data-count>{v}</span>
          </span>
          <span class="g__l">{label}</span>
        </li>
      ))}
    </ul>
    <p class="ps__meta"><span class="dot" aria-hidden="true"></span>Lighthouse · Google PageSpeed Insights{host && <> · <a href={`https://pagespeed.web.dev/analysis?url=${encodeURIComponent(url!)}`} target="_blank" rel="noopener">Run It Yourself ↗</a></>}</p>
  </div>
</section>
<style>
  .ps { margin-top: 56px; background: var(--cream); padding: clamp(32px, 4vw, 48px); padding: round(clamp(32px, 4vw, 48px), 8px); }
  .ps__gauges { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 32px; }
  .g { display: grid; justify-items: center; gap: 16px; }
  .g__ring { position: relative; display: grid; place-items: center; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .g:hover .g__ring { transform: scale(1.06); }
  .g__v { position: absolute; font-family: var(--font-display); font-size: 2.1rem; letter-spacing: -0.04em; }
  .g__l { font-weight: 500; font-size: var(--fs-small); }
  .ps__meta { margin-top: 32px; padding-top: 16px; border-top: 1.5px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: var(--fs-xs); color: var(--brand-ink); }
  .ps__meta a { color: var(--brand); font-weight: 500; }
  .ps__meta a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .dot { width: 8px; height: 8px; background: var(--brand); }
  @media (max-width: 600px) { .ps { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
