---
import { highlight } from '../../lib/highlight';
import type { CaseStudy } from '../../data/projects';
const { code } = Astro.props as { code: CaseStudy['code'] };
const lines = highlight(code.source, code.language);
---
<figure class="code" aria-labelledby="code-caption" data-code data-nav-tone="light"><!-- the orange bar already reads on the dark code window: never invert here -->
  <div class="code__bar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="tab tab--active">{code.file}</span>
    <span class="tab">{code.secondaryFile}</span>
    <span class="lang">{code.language} · UTF-8</span>
  </div>
  <pre class="code__pre" tabindex="0"><code>{lines.map((l, i) => <span class:list={['ln', i + 1 === code.highlightLine && 'ln--hl']} set:html={l || ' '} />)}</code></pre>
  <div class="code__term"><code><span class="prompt">{code.command.slice(0, 1)}</span>{code.command.slice(1)}</code><span class="ok" data-type>{code.commandResult}</span><span class="caret" aria-hidden="true"></span></div>
  <figcaption id="code-caption" class="visually-hidden">Source excerpt from {code.file} ({code.language}).</figcaption>
</figure>
<style>
  .code { background: var(--ink-dark); color: #f3e3d8; display: flex; flex-direction: column; min-width: 0; }
  .code__bar { display: flex; align-items: center; height: 44px; background: #2b1408; font-size: var(--fs-xs); }
  .dots { display: flex; gap: 8px; padding: 0 16px; }
  .dots i { width: 8px; height: 8px; background: #6b3a1e; } .dots i:nth-child(2) { background: #9a4f22; } .dots i:nth-child(3) { background: #e07a3a; }
  .tab { padding: 0 16px; height: 100%; display: flex; align-items: center; color: #b87a56; }
  .tab--active { background: var(--ink-dark); color: #f3e3d8; box-shadow: inset 0 2px 0 #e07a3a; font-weight: 500; }
  .lang { margin-left: auto; padding-right: 16px; color: #b87a56; }
  @media (max-width: 560px) { .lang, .tab:not(.tab--active) { display: none; } }
  .code__pre { margin: 0; padding: 24px 0; overflow-x: auto; font-family: var(--font-body); font-size: 0.84375rem; line-height: 25px; counter-reset: ln; flex: 1; }
  .code__pre code { display: grid; min-width: max-content; }
  .ln { display: block; padding: 0 24px 0 64px; position: relative; white-space: pre; }
  .ln::before { counter-increment: ln; content: counter(ln); position: absolute; left: 0; width: 40px; text-align: right; color: #a87050; }
  .ln--hl { background: rgb(224 122 58 / .1); box-shadow: inset 2px 0 0 #e07a3a; }
  .code :global(.tok-k) { color: #ff8a3d; font-weight: 500; }
  .code :global(.tok-s) { color: #f6c19a; }
  .code :global(.tok-c) { color: #b87a56; font-style: italic; }
  .code :global(.tok-n) { color: #ffb27a; }
  .code :global(.tok-f), .code :global(.tok-i) { color: #ffd3b0; }
  .code__term { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 16px 16px; background: #2b1408; font-size: var(--fs-xs); }
  .code__term code { font-family: var(--font-body); }
  .prompt { color: #e07a3a; }
  .ok { color: #ffb27a; }
  .caret { width: 8px; height: 15px; background: #e07a3a; animation: blink 1.1s steps(1) infinite; align-self: center; }
  @keyframes blink { 50% { opacity: 0; } }
  .ln { transition: background-color .25s; }
  .ln:hover { background: rgb(255 255 255 / .04); }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
</style>
