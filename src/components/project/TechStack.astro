---
import SectionHeader from '../ui/SectionHeader.astro';
import CodeWindow from './CodeWindow.astro';
import { pad2 } from '../../lib/text';
import type { CaseStudy } from '../../data/projects';
const { cs } = Astro.props as { cs: CaseStudy };
---
<section class="section container" aria-labelledby="stack-title">
  <SectionHeader id="stack-title" eyebrow="05 · Stack" title={'The Stack,\nAnd The Code'} lead={cs.stackLead} />
  <div class="row">
    <dl class="stack" data-stagger data-each=".07">
      {cs.stack.map((g, i) => (
        <div class="group">
          <dt>{pad2(i + 1)} {g.group}</dt>
          <dd><ul role="list" class="chips">{g.items.map((it, k) => <li class:list={['chip', k === 0 && 'chip--primary']}>{it}</li>)}</ul></dd>
        </div>
      ))}
    </dl>
    <CodeWindow code={cs.code} />
  </div>
</section>
<style>
  .row { margin-top: 56px; display: grid; gap: 40px; }
  .group { display: grid; grid-template-columns: 120px 1fr; align-items: center; gap: 12px; padding: 20px 0; border-top: 1.5px solid var(--line); }
  .group:last-child { border-bottom: 1.5px solid var(--line); }
  dt { font-weight: 500; font-size: var(--fs-small); color: var(--brand-ink); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 11px; background: var(--cream); border: 1px solid var(--line); font-weight: 500; font-size: var(--fs-small); }
  .chip::before { content: ''; width: 5px; height: 5px; background: rgb(171 66 0 / .6); }
  .chip { transition: background-color .35s, color .35s, transform .45s cubic-bezier(.16,1,.3,1); }
  .chip:hover { transform: translateY(-3px); background: var(--brand); color: var(--white); }
  .chip:hover::before { background: var(--white); }
  .chip--primary { background: var(--brand); border-color: var(--brand); color: var(--white); }
  .chip--primary::before { background: var(--white); }
  @media (min-width: 1100px) { .row { grid-template-columns: 1fr 746px; } }
</style>
