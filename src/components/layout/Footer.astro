---
import { site, footerNav } from '../../data/site';
import { socialIcons } from '../../lib/graphics/icons';
const year = new Date().getFullYear();
const cols = [
  { title: 'Menu', links: footerNav.menu },
  { title: 'Service', links: footerNav.services },
  { title: 'Contact Us', links: footerNav.contact },
];
---
<footer class="site-footer container section">
  <div class="panel on-brand">
    <div class="top">
      <div class="follow">
        <h2 class="heading">Follow Us</h2>
        <ul class="socials" role="list" data-stagger data-each=".07">
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener noreferrer me"><span class="visually-hidden">{site.name} on {s.name}</span>
              <svg width="55" height="55" viewBox="0 0 55 55" fill="none" aria-hidden="true" focusable="false" set:html={socialIcons[s.name]} />
            </a></li>
          ))}
        </ul>
      </div>
      <nav class="cols" aria-label="Footer" data-stagger data-each=".1">
        {cols.map((c) => (
          <div class="col">
            <h2 class="heading">{c.title}</h2>
            <ul role="list">{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
          </div>
        ))}
      </nav>
    </div>
    <address class="meta">
      <span>© {year} {site.legalName}</span>
      <span>{site.address.street}, {site.address.locality}, {site.address.countryName}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </address>
    <div class="wordmark" aria-hidden="true"><img src="/logo.svg" width="1286" height="574" alt="" loading="lazy" decoding="async" data-rise /></div>
  </div>
</footer>
<style>
  .panel { background: var(--brand); container-type: inline-size; overflow: hidden; padding: clamp(28px, 4.5vw, 56px) clamp(20px, 2.8vw, 36px) 0; }
  .top { display: grid; gap: 40px; }
  .heading { font-family: var(--font-body); font-weight: 500; font-size: var(--fs-body); line-height: 1.4; }
  .follow { display: grid; align-content: start; }
  .follow .socials { margin-top: 20px; }   /* same heading → content rhythm as the link columns: shares their first row */
  .socials { display: flex; gap: 20px; }
  .socials a { display: block; background: rgb(255 255 255 / .14); color: var(--white); transition: background-color .35s, color .35s, transform .45s cubic-bezier(.16,1,.3,1); }
  .socials a:hover { background: var(--white); color: var(--brand); transform: translateY(-4px); }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; }
  .col ul { margin-top: 18px; display: grid; gap: 6px; }
  .col a { color: var(--on-brand-muted); font-size: 0.906rem; display: inline-flex; gap: 12px; align-items: center; padding: 2px 0; }
  .col a::before { content: ''; width: 3px; height: 3px; background: currentColor; border-radius: 50%; }
  .col a { transition: color .3s, transform .45s cubic-bezier(.16,1,.3,1); }
  .col a:hover { color: var(--white); transform: translateX(6px); }
  .meta { font-style: normal; margin-top: 48px; display: flex; flex-wrap: wrap; gap: 6px 28px; font-size: var(--fs-xs); color: var(--on-brand-muted); }
  .meta a:hover { color: var(--white); }
  .wordmark { margin-top: calc(clamp(28px, 4vw, 56px) + 32px); overflow: hidden; line-height: 0; user-select: none; display: flex; justify-content: center; }
  .wordmark img { display: block; width: 100%; max-width: 100%; height: auto; margin-inline: auto; margin-bottom: calc(-6.2% + 16px); } /* sinks ~20% of its height below the footer edge (clipped), like a ghost wordmark */
  @media (min-width: 900px) {
    .top { grid-template-columns: minmax(0, 1.55fr) minmax(0, 2.45fr); min-height: 250px; }
    .cols { grid-template-columns: 1fr 1.35fr 0.9fr; }
  }
  @media (max-width: 600px) { .panel { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
