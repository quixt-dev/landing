---
import { nav } from '../../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => !href.includes('#') && (href === '/' ? path === '/' : path.startsWith(href));
const all = [...nav.left, ...nav.right];
---
<header class="site-header container">
  <nav class="nav" aria-label="Primary">
    <ul class="nav__list nav__list--left" role="list">
      {nav.left.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <a class="nav__logo" href="/" aria-label="Quixt home"><Logo height={32} invertible /></a>
    <ul class="nav__list nav__list--right" role="list">
      {nav.right.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <details class="nav__mobile">
      <summary><span class="visually-hidden">Open Menu</span><span class="burger" aria-hidden="true"><i></i><i></i></span></summary>
      <ul role="list">{all.map((l) => <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}</ul>
    </details>
  </nav>
  <svg class="nav-tabs" width="1300" height="18" viewBox="0 0 1300 18" fill="none" aria-hidden="true" focusable="false">
    <path d={Array.from({ length: 11 }, (_, i) => { const x = i * 118; return `M${x} 0L${x + 10} 16H${x + 104}L${x + 114} 0`; }).join('')} stroke="#AB4200" stroke-opacity=".08" />
  </svg>
</header>

<script>
  // The bar inverts (white bar, orange logo, links and tab lines) whenever what's UNDER it is dark: the orange
  // panels (process, footer, dark bento tiles, contact cards…) and duotone photos. Instead of a hand-kept list, it
  // samples five points across the bar each frame, finds the page element below each one and walks up to the first
  // solid background (images, video and canvas count as dark unless marked data-nav-tone="light"). Majority wins.
  {
    const bar = document.querySelector<HTMLElement>('.site-header');
    if (bar) {
      const nav = bar.querySelector<HTMLElement>('.nav')!;
      const lum = (c: string) => { const m = c.match(/[\d.]+/g); if (!m) return null; const [r, g, b, a = '1'] = m; if (+a < 0.5) return null;
        const f = (v: string) => { const x = +v / 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4; };
        return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b); };
      // an image's real brightness, measured once from a 24 px downscale (same-origin); unreadable images count as dark
      const imgTone = new WeakMap<HTMLImageElement, boolean>();
      const imgDark = (im: HTMLImageElement) => {
        if (imgTone.has(im)) return imgTone.get(im)!;
        if (!im.complete || !im.naturalWidth) return true;
        let dark = true;
        try {
          const c = document.createElement('canvas'); c.width = c.height = 24;
          const g = c.getContext('2d', { willReadFrequently: true })!; g.drawImage(im, 0, 0, 24, 24);
          const d = g.getImageData(0, 0, 24, 24).data; let sum = 0, n = 0;
          for (let i = 0; i < d.length; i += 4) { if (d[i + 3] < 128) continue; sum += lum(`rgb(${d[i]},${d[i + 1]},${d[i + 2]})`)!; n++; }
          dark = n ? sum / n < 0.3 : false;
        } catch { dark = true; }
        imgTone.set(im, dark);
        return dark;
      };
      const darkAt = (x: number, y: number) => {
        // the intro loader (#zl) covers the page on first load; it is not the page, so it never counts as "dark"
        const under = document.elementsFromPoint(x, y).find((el) => !bar.contains(el) && el !== document.documentElement && !el.closest('#zl'));
        // an explicit data-nav-tone on any ancestor wins over every background inside it (e.g. the code window's lines)
        const toned = under?.closest<HTMLElement>('[data-nav-tone]');
        if (toned) return toned.dataset.navTone === 'dark';
        for (let el = under as HTMLElement | null; el && el !== document.body; el = el.parentElement) {
          if (el.tagName === 'IMG') return imgDark(el as HTMLImageElement);
          if (/^(VIDEO|PICTURE)$/.test(el.tagName)) return true;
          const L = lum(getComputedStyle(el).backgroundColor);
          if (L != null) return L < 0.3;
        }
        return false;   // page background (white)
      };
      let ticking = 0;
      const check = () => {
        ticking = 0;
        const r = nav.getBoundingClientRect(), y = r.top + r.height / 2;
        let dark = 0;
        for (const f of [0.08, 0.3, 0.5, 0.7, 0.92]) if (darkAt(r.left + r.width * f, y)) dark++;
        bar.classList.toggle('is-inverted', dark >= 3);
      };
      addEventListener('scroll', () => { if (!ticking) ticking = requestAnimationFrame(check); }, { passive: true });
      addEventListener('resize', check); addEventListener('load', check); addEventListener('zx:loaded', check); check();
    }
  }
  // Scroll-spy (home page): the nav item for the section under the reading line (just below the sticky bar) gets
  // aria-current="location", so the underline follows you down the page. Sections without their own item keep the last one.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header && location.pathname === '/') {
    const MAP: [string, string | null][] = [
      ['.hero', '/'], ['#about', '/#about'], ['#services', '/#services'], ['#process', '/#services'],
      ['#work', '/projects/'], ['#pricing', '/#services'], ['#testimonials', '/projects/'], ['#faq', null], ['.site-footer', '/contact/'],
    ];
    const sections = MAP.map(([sel, href]) => ({ el: document.querySelector<HTMLElement>(sel), href })).filter((s) => s.el);
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>('a[href]')).filter((a) => !a.classList.contains('nav__logo'));
    let current = '';
    const apply = (href: string) => {
      if (href === current) return;
      current = href;
      for (const a of links) {
        const on = a.getAttribute('href') === href;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', href === '/' ? 'page' : 'location');
        else a.removeAttribute('aria-current');
      }
    };
    const update = () => {
      const top = header.getBoundingClientRect().bottom;
      const line = top + (innerHeight - top) * 0.3;
      let href = '/';
      for (const s of sections) if (s.el!.getBoundingClientRect().top <= line && s.href) href = s.href;
      if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) href = '/contact/';   // reached the end
      apply(href);
    };
    let raf = 0;
    const schedule = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; update(); }); };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    addEventListener('load', update);
    update();
  }
</script>

<style>
  /* sticky bar: transparent, with the tab lines attached directly under the nav (no gap) */
  .site-header { position: sticky; top: 0; z-index: 60; padding-top: var(--gutter); background: transparent; }
  .nav { position: relative; display: flex; align-items: center; justify-content: space-between; min-height: 50px; padding: 0 20px; background: var(--brand); color: var(--white); transition: background-color .45s cubic-bezier(.16,1,.3,1), color .45s cubic-bezier(.16,1,.3,1), box-shadow .45s; }
  /* inverted over orange surfaces (footer): white bar, brand-orange logo, links and underline */
  .site-header.is-inverted .nav { background: var(--white); color: var(--brand); box-shadow: 0 1px 0 rgb(171 66 0 / .12), 0 18px 40px -24px rgb(30 13 4 / .45); }
  .site-header.is-inverted .nav__mobile ul { background: var(--white); }
  .site-header.is-inverted .nav__mobile li a { border-top-color: var(--line); }
  .nav__list { display: none; gap: 22px; font-weight: 500; font-size: var(--fs-body); }
  .nav__list a { position: relative; display: inline-flex; align-items: center; gap: 12px; padding: 12px 0; }
  .nav__list a::before { content: ''; width: 4px; height: 4px; background: currentColor; border-radius: 50%; }
  .nav__list a::after { content: ''; position: absolute; left: 16px; right: 0; bottom: 8px; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: 100% 50%; transition: transform .5s cubic-bezier(.16,1,.3,1); }
  /* active item (server aria-current on real pages, scroll-spy .is-active on the home sections) */
  .nav__list a:hover::after, .nav__list a[aria-current]::after, .nav__list a.is-active::after { transform: scaleX(1); transform-origin: 0 50%; }
  .nav__list a::before { transition: transform .4s cubic-bezier(.16,1,.3,1); }
  .nav__list a:hover::before { transform: scale(1.8); }
  .nav__logo :global(.logo) { transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .nav__logo:hover :global(.logo) { transform: scale(1.04); }
  .nav__logo { padding: 12px 0; }
  .nav-tabs { display: block; width: 100%; height: auto; margin-top: -1px; pointer-events: none; }
  .nav-tabs path { transition: stroke .45s cubic-bezier(.16,1,.3,1), stroke-opacity .45s; }
  .site-header.is-inverted .nav-tabs path { stroke: #fff; stroke-opacity: .6; }   /* the tab lines turn white over the footer too */
  .nav__mobile summary { list-style: none; cursor: pointer; padding: 14px 4px; }
  .nav__mobile summary::-webkit-details-marker { display: none; }
  .burger { display: grid; gap: 6px; width: 22px; }
  .burger i { display: block; height: 1.5px; background: currentColor; transition: transform .2s; }
  .nav__mobile[open] .burger i:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav__mobile[open] .burger i:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .nav__mobile ul { position: absolute; z-index: 20; left: 0; right: 0; top: 100%; background: var(--brand); padding: 8px 20px 20px; display: grid; }
  .nav__mobile li a { display: block; padding: 12px 0; border-top: 1px solid var(--line-on-brand); font-weight: 500; }
  @media (min-width: 900px) {
    .nav { display: grid; grid-template-columns: 1fr auto 1fr; }
    .nav__list { display: flex; }
    .nav__list--right { justify-content: end; }
    .nav__mobile { display: none; }
  }
</style>

