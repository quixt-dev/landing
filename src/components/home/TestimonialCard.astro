---
import Avatar from '../ui/Avatar.astro';
export interface Props { quote: string; name: string; role: string; avatar: number }
const { quote, name, role, avatar } = Astro.props;
---
<figure class="tcard">
  <blockquote><p>{quote}</p></blockquote>
  <figcaption>
    <Avatar index={avatar} size={28} />
    <span><cite>{name}</cite><span class="role">{role}</span></span>
  </figcaption>
</figure>
<style>
  .tcard { transition: background-color .5s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); background: var(--cream); padding: 32px 30px; display: flex; flex-direction: column; justify-content: space-between; gap: 36px; min-height: 251px; }
  blockquote p { font-family: var(--font-display); font-size: clamp(1.05rem, 1.35vw, 1.1875rem); line-height: 1.28; max-width: 22rem; }
  .tcard:hover { background: var(--brand); color: var(--white); transform: translateY(-6px); }
  .tcard:hover .role { color: var(--on-brand-muted); }
  figcaption { display: flex; align-items: center; gap: 10px; }
  cite { display: block; font-style: normal; font-weight: 500; font-size: 0.78rem; }
  .role { display: block; font-size: 0.66rem; color: var(--brand-ink); }
  @media (max-width: 600px) { .tcard { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
