---
import Button from '../ui/Button.astro';
import { cornerDots } from '../../lib/graphics/inline';
export interface Props { id: string; name: string; bestFor: string; price: number; currency: string; timeline: string; features: string[]; featured: boolean }
const { id, name, bestFor, price, currency, timeline, features, featured } = Astro.props;
const dots = cornerDots();
const [thousands, rest] = price.toLocaleString('en-US').split(',');
---
<article class="plan on-brand" aria-labelledby={`plan-${id}`}>
  <svg class="plan__dots" width="180" height="160" viewBox="0 0 180 160" fill="none" aria-hidden="true" set:html={dots} />
  <h3 id={`plan-${id}`} class="plan__name">{name}</h3>
  <p class="plan__for">Best For: {bestFor}</p>
  <div class="plan__row">
    <!-- The display face is monospace, so "$" and "," each take a full cell; they get their own spans to be optically tightened. -->
    <p class="plan__price"><span class="plan__from">From</span><data class="plan__num" value={price}><span class="cur">$</span>{thousands}<span class="sep">,</span>{rest}</data><span class="visually-hidden"> {currency}</span></p>
    <p class="plan__time"><span>Ships In</span>{timeline}</p>
  </div>
  <p class="plan__inc">Includes:</p>
  <ul class="plan__features" role="list">{features.map((f) => <li>{f}</li>)}</ul>
  <Button href={`/contact/?plan=${id}`} variant={featured ? 'light' : 'outline-light'} full>Get A Fixed Quote<span class="visually-hidden"> For The {name}</span></Button>
</article>
<style>
  .plan { position: relative; overflow: hidden; background: var(--brand); padding: clamp(32px, 4vw, 48px) clamp(24px, 4.3vw, 56px) clamp(32px, 4.3vw, 56px); padding: round(clamp(32px, 4vw, 48px), 8px) round(clamp(24px, 4.3vw, 56px), 8px) round(clamp(32px, 4.3vw, 56px), 8px); display: flex; flex-direction: column; }
  .plan { transition: transform .7s cubic-bezier(.16,1,.3,1), box-shadow .7s; }
  .plan:hover { transform: translateY(-8px); box-shadow: 0 30px 60px -30px rgb(120 45 0 / .55); }
  .plan__dots { position: absolute; top: 0; right: 0; transition: transform 1.2s cubic-bezier(.16,1,.3,1), opacity .6s; opacity: .8; }
  .plan:hover .plan__dots { transform: translate(-14px, 10px) scale(1.12); opacity: 1; }
  /* a slow wave of light radiates from the corner through the grid: each dot brightens and swells a touch as the
     crest passes, then settles back to its resting opacity. Hovering the card quickens the wave. */
  .plan__dots :global(rect) { transform-box: fill-box; transform-origin: center; animation: dot-wave 4.2s cubic-bezier(.45,0,.2,1) var(--d) infinite both; }
  .plan:hover .plan__dots :global(rect) { animation-duration: 2.8s; }
  @keyframes dot-wave {
    0%, 46%, 100% { opacity: calc(var(--o) * .55); transform: scale(1); }
    14% { opacity: min(1, calc(var(--o) * 1.5 + .25)); transform: scale(1.45); }
  }
  @media (prefers-reduced-motion: reduce) { .plan__dots :global(rect) { animation: none; } }
  .plan__features li { transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .plan:hover .plan__features li { transform: translateX(6px); }
  .plan:hover .plan__features li:nth-child(2) { transition-delay: .03s; } .plan:hover .plan__features li:nth-child(3) { transition-delay: .06s; }
  .plan:hover .plan__features li:nth-child(4) { transition-delay: .09s; } .plan:hover .plan__features li:nth-child(5) { transition-delay: .12s; } .plan:hover .plan__features li:nth-child(6) { transition-delay: .15s; }
  .plan__name { font-size: var(--fs-h3); letter-spacing: var(--track-l); word-spacing: var(--words-l); }
  .plan__for { margin-top: 12px; font-size: 0.875rem; color: var(--on-brand-muted); }
  .plan__row { margin-top: 48px; padding: 16px 0 16px; border-block: 1px solid var(--line-on-brand); display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px 24px; }
  .plan__price { display: grid; font-family: var(--font-display); font-weight: 500; font-size: clamp(3.4rem, 6vw, 5.25rem); line-height: 1.1; letter-spacing: -0.04em; }
  .plan__num { display: block; }
  .cur { margin-right: .07em; }
  .sep { margin-inline: -.16em -.12em; }
  .plan__from, .plan__time span { font-family: var(--font-body); font-weight: 400; font-size: 0.875rem; letter-spacing: 0; color: var(--on-brand-muted); }
  .plan__time { display: grid; gap: 2px; text-align: right; font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.2; padding-bottom: .55em; }
  .plan__inc { margin-top: 32px; font-size: 0.875rem; color: var(--on-brand-muted); }
  .plan__features { margin: 24px 0 64px 8px; font-family: var(--font-display); font-size: clamp(1.05rem, 1.7vw, 1.375rem); line-height: 1.64; flex: 1; }
  .plan__features li::before { content: '• '; }
  @media (max-width: 600px) { .plan { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
