---
import SectionHeader from '../ui/SectionHeader.astro';
import PricingCard from './PricingCard.astro';
import { pricing } from '../../data/home';
---
<section id="pricing" class="section container" aria-labelledby="pricing-title">
  <SectionHeader id="pricing-title" align="center" title={pricing.title} lead={pricing.lead} />
  <div class="plans" data-stagger data-each=".14">{pricing.plans.map((p) => <PricingCard {...p} />)}</div>
</section>
<style>
  .plans { margin-top: 58px; display: grid; gap: 22px; }
  @media (min-width: 900px) { .plans { grid-template-columns: 1fr 1fr; } }
</style>
