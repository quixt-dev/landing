---
import { createHash } from 'node:crypto';
import Lines from '../ui/Lines.astro';
import Button from '../ui/Button.astro';
import TagList from '../ui/TagList.astro';
import { founder } from '../../data/home';
// Short, stable "commit hashes" for the git-log styling (derived from each line, so builds are reproducible).
const sha = (s: string) => createHash('sha1').update(s).digest('hex').slice(0, 7);
---
<section id="founder" class="section container founder" aria-labelledby="founder-title">
  <div class="founder__copy">
    <h2 id="founder-title" class="h2" data-split><Lines text={founder.title} /></h2>
    <p class="lead" data-reveal data-delay=".15">{founder.lead}</p>
    <div class="founder__certs" data-reveal data-delay=".2"><TagList tags={founder.certs} label="Certifications" /></div>
    <div class="founder__ctas" data-reveal data-delay=".25">
      <Button href={founder.linkedin} variant="solid" external>Connect On LinkedIn ↗</Button>
      <Button href="/contact/#book-a-call">Book A Call With Me</Button>
    </div>
  </div>
  <figure class="log" data-reveal data-delay=".2" data-nav-tone="light">
    <div class="log__bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="tab">~/dhiraj</span><span class="branch">main</span></div>
    <div class="log__body">
      <p class="log__cmd" aria-hidden="true"><span class="prompt">$</span> git log --oneline --author="{founder.name}"</p>
      <ol class="log__list" role="list" data-stagger data-each=".08">
        {founder.log.map((l, i) => (
          <li class="log__line">
            <span class="hash" aria-hidden="true">{sha(l.year + l.text)}</span>
            <span class="msg">{i === 0 && <span class="head" aria-hidden="true">(HEAD → main) </span>}<span class="type">{l.type}:</span> {l.text}</span>
            <time class="year" datetime={l.year}>{l.year}</time>
          </li>
        ))}
      </ol>
      <p class="log__end" aria-hidden="true"><span class="prompt">$</span> <span class="caret"></span></p>
    </div>
    <figcaption class="visually-hidden">Career timeline of {founder.name}, most recent first.</figcaption>
  </figure>
</section>
<style>
  .founder { display: grid; gap: 48px; align-items: center; }
  .founder__copy { display: grid; gap: 24px; justify-items: start; }
  .founder .lead { max-width: 36rem; }
  .founder__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  /* git log window: same palette as the case-study code window */
  .log { margin: 0; background: var(--ink-dark); color: #f3e3d8; min-width: 0; }
  .log__bar { display: flex; align-items: center; height: 44px; background: #2b1408; font-size: var(--fs-xs); }
  .dots { display: flex; gap: 8px; padding: 0 16px; }
  .dots i { width: 8px; height: 8px; background: #6b3a1e; } .dots i:nth-child(2) { background: #9a4f22; } .dots i:nth-child(3) { background: #e07a3a; }
  .tab { padding: 0 16px; height: 100%; display: flex; align-items: center; background: var(--ink-dark); box-shadow: inset 0 2px 0 #e07a3a; font-weight: 500; }
  .branch { margin-left: auto; padding-right: 16px; color: #b87a56; }
  .branch::before { content: '⎇ '; }
  .log__body { padding: 24px clamp(16px, 2.4vw, 32px) 32px; padding: 24px round(clamp(16px, 2.4vw, 32px), 8px) 32px; font-size: 0.84375rem; line-height: 1.6; }
  .log__cmd, .log__end { color: #b87a56; }
  .prompt { color: #e07a3a; }
  .log__list { margin: 16px 0; display: grid; gap: 2px; }
  .log__line { display: grid; grid-template-columns: 7ch 1fr auto; gap: 16px; padding: 8px 8px; margin-inline: -8px; transition: background-color .25s; }
  .log__line:hover { background: rgb(255 255 255 / .04); }
  .log__line:first-child { background: rgb(224 122 58 / .1); box-shadow: inset 2px 0 0 #e07a3a; }
  .hash { color: #ffb27a; }
  .head { color: #ff8a3d; font-weight: 500; }
  .type { color: #f6c19a; }
  .year { color: #a87050; }
  .caret { display: inline-block; width: 8px; height: 15px; background: #e07a3a; vertical-align: -2px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  @media (max-width: 560px) { .log__line { grid-template-columns: 1fr auto; } .hash { display: none; } .branch { display: none; } }
  @media (min-width: 1000px) { .founder { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 64px; } }
</style>
