---
import TagList from '../ui/TagList.astro';
import Icon from '../ui/Icon.astro';
import { serviceIcons } from '../../lib/graphics/icons';
import { pad2 } from '../../lib/text';
export interface Props { title: string; slug: string; description: string; tags: string[]; icon: string; index: number }
const { title, slug, description, tags, icon, index } = Astro.props;
---
<article class="svc" id={`service-${slug}`}>
  <div class="svc__top">
    <span class="svc__icon"><Icon paths={serviceIcons[icon]} size={36} viewBox={36} /></span>
    <span class="svc__index" aria-hidden="true">{pad2(index)}</span>
  </div>
  <div class="svc__body">
    <h3 class="svc__title">{title}</h3>
    <p class="svc__desc">{description}</p>
    <TagList tags={tags} label={`${title} technologies`} />
  </div>
</article>
<style>
  .svc { position: relative; overflow: hidden; background: var(--cream); padding: 26px; transition: background-color .5s cubic-bezier(.16,1,.3,1); display: flex; flex-direction: column; justify-content: space-between; gap: 64px; min-height: 360px; }
  .svc__top { display: flex; justify-content: space-between; align-items: start; }
  .svc__icon { background: var(--brand); color: var(--white); width: 36px; height: 36px; display: grid; place-items: center; }
  .svc__index { width: 36px; height: 36px; display: grid; place-items: center; background: var(--white); border: 1px solid var(--line-soft); font-size: 0.75rem; }
  .svc__title { font-size: var(--fs-h3); line-height: var(--lh-tight); letter-spacing: var(--track-l); word-spacing: var(--words-l); }
  .svc__desc { margin: 12px 0 24px; font-size: 0.84rem; line-height: 1.5; color: var(--brand-ink); max-width: 34ch; }
  .svc::after { content: ''; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--brand); transform: scaleX(0); transform-origin: 0 50%; transition: transform .7s cubic-bezier(.16,1,.3,1); }
  .svc:hover { background: var(--cream-2); }
  .svc:hover::after { transform: scaleX(1); }
  .svc__icon, .svc__index { transition: transform .6s cubic-bezier(.16,1,.3,1), background-color .35s, color .35s; }
  .svc:hover .svc__index { background: var(--brand); color: var(--white); }
  .svc__title { transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .svc:hover .svc__title { transform: translateY(-6px); }
  @media (min-width: 1100px) { .svc { min-height: 433px; } }
  @media (max-width: 600px) { .svc { padding-left: var(--card-x-m); padding-right: var(--card-x-m); } }   /* unified mobile card inset */
</style>
