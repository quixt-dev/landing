---
/**
 * Full-screen "theatre" video player for a Mux public playback ID.
 * The markup ships as a closed <dialog>; src/scripts/videoTheatre.ts (and hls.js) load only when a visitor
 * shows intent ([data-film-open] hover / focus / touch), then a click morphs the trigger photo into the stage.
 * Keyboard: Space/K play · ←/→ 5 s · J/L 10 s · ↑/↓ volume · M mute · F fullscreen · C captions · 0–9 jump · Esc close
 */
interface Props { playbackId: string; title: string; eyebrow: string; label: string }
const { playbackId, title, eyebrow } = Astro.props;
const poster = `https://image.mux.com/${playbackId}/thumbnail.webp?width=1920&time=0`;
---
<dialog class="vt" data-theatre data-playback-id={playbackId} aria-label={`Video: ${title}`}>
  <div class="vt__bg" data-bg aria-hidden="true"></div>

  <header class="vt__top" data-chrome>
    <p class="vt__meta"><span class="vt__dot" aria-hidden="true"></span><span>{eyebrow}</span><span class="vt__sep" aria-hidden="true">/</span><strong>{title}</strong></p>
    <button type="button" class="vt__close" data-close aria-label="Close video"><kbd aria-hidden="true">Esc</kbd><span>Close</span>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6"/></svg></button>
  </header>

  <div class="vt__stage" data-stage>
    <video class="vt__video" data-video playsinline preload="none" poster={poster} crossorigin="anonymous" aria-label={title}></video>
    <span class="vt__cb" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

    <button type="button" class="vt__hit" data-hit tabindex="-1" aria-hidden="true"></button>

    <!-- centre states: big play (paused), pulse (toggle feedback), spinner (buffering), flash (+5 s, volume…) -->
    <button type="button" class="vt__big" data-big aria-label="Play">
      <span class="vt__ring" aria-hidden="true"></span><span class="vt__ring" aria-hidden="true"></span>
      <span class="vt__disc" aria-hidden="true"></span>
      <svg viewBox="0 0 60 72" aria-hidden="true"><path d="M0 0L60 36L0 72Z" fill="currentColor"/></svg>
    </button>
    <span class="vt__pulse" data-pulse aria-hidden="true"></span>
    <span class="vt__spin" data-spin aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="vt__flash" data-flash aria-hidden="true"></span>
    <button type="button" class="vt__unmute" data-unmute hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6h3l4-3v10l-4-3H2z" fill="currentColor"/><path d="M11.5 5.5l3 5M14.5 5.5l-3 5" stroke="currentColor" stroke-width="1.4"/></svg>
      Tap To Unmute</button>

    <div class="vt__end" data-end hidden>
      <p class="vt__end-eyebrow">Thanks For Watching</p>
      <p class="vt__end-title">Like What You See?</p>
      <div class="vt__end-btns">
        <a class="vt__cta" href="/contact/" data-fill>Start A Project <span aria-hidden="true">→</span></a>
        <button type="button" class="vt__ghost-btn" data-replay>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2.5 7a4.5 4.5 0 1 0 1.3-3.2M2.5 1.5v2.8h2.8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          Replay</button>
      </div>
    </div>

    <div class="vt__ui" data-ui>
      <div class="vt__scrub" data-scrub role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="00:00 of 00:00">
        <span class="vt__track"><span class="vt__buf" data-buf></span><span class="vt__hover" data-hoverbar></span><span class="vt__fill" data-fill-bar></span></span>
        <span class="vt__head" data-head aria-hidden="true"></span>
        <span class="vt__tip" data-tip aria-hidden="true"><span class="vt__thumb" data-thumb></span><span class="vt__tiptime" data-tiptime>00:00</span></span>
      </div>

      <div class="vt__bar">
        <div class="vt__group">
          <button type="button" class="vt__btn" data-toggle aria-label="Play">
            <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3l12 7-12 7z" fill="currentColor"/></svg>
            <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 3h3.5v14H5zM11.5 3H15v14h-3.5z" fill="currentColor"/></svg>
          </button>
          <button type="button" class="vt__btn vt__btn--sm" data-back aria-label="Back 10 seconds">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3M4 3v3.4h3.4" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="10" y="12.6" text-anchor="middle" font-size="6.2" font-family="ui-monospace,monospace" fill="currentColor">10</text></svg>
          </button>
          <button type="button" class="vt__btn vt__btn--sm" data-fwd aria-label="Forward 10 seconds">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10a6 6 0 1 1-1.8-4.3M16 3v3.4h-3.4" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="10" y="12.6" text-anchor="middle" font-size="6.2" font-family="ui-monospace,monospace" fill="currentColor">10</text></svg>
          </button>
          <div class="vt__vol">
            <button type="button" class="vt__btn" data-mute aria-label="Mute">
              <svg class="i-vol" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7.5h3.2L11 4v12l-4.8-3.5H3z" fill="currentColor"/><path class="w1" d="M13.5 7.5a3.2 3.2 0 0 1 0 5" fill="none" stroke="currentColor" stroke-width="1.5"/><path class="w2" d="M15.6 5.3a6.3 6.3 0 0 1 0 9.4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              <svg class="i-muted" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7.5h3.2L11 4v12l-4.8-3.5H3z" fill="currentColor"/><path d="M13.5 7.5l4 5M17.5 7.5l-4 5" stroke="currentColor" stroke-width="1.5"/></svg>
            </button>
            <label class="vt__vol-range"><span class="visually-hidden">Volume</span><input type="range" min="0" max="1" step="0.05" value="1" data-volume /></label>
          </div>
          <p class="vt__time" aria-hidden="true"><span data-cur>00:00</span><span class="vt__slash">/</span><span data-dur>00:00</span></p>
        </div>

        <div class="vt__group">
          <div class="vt__menu-wrap">
            <button type="button" class="vt__btn vt__btn--text" data-menu-btn="speed" aria-haspopup="true" aria-expanded="false" aria-label="Playback speed"><span data-speed-label>1×</span></button>
            <div class="vt__menu" data-menu="speed" role="menu" aria-label="Playback speed" hidden></div>
          </div>
          <div class="vt__menu-wrap" data-quality-wrap hidden>
            <button type="button" class="vt__btn vt__btn--text" data-menu-btn="quality" aria-haspopup="true" aria-expanded="false" aria-label="Quality"><span data-quality-label>Auto</span></button>
            <div class="vt__menu" data-menu="quality" role="menu" aria-label="Quality" hidden></div>
          </div>
          <button type="button" class="vt__btn vt__btn--text" data-cc aria-pressed="false" aria-label="Captions" hidden>CC</button>
          <button type="button" class="vt__btn" data-pip aria-label="Picture in picture" hidden>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 4.5h15v11h-15z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10.5 9.5h5v4h-5z" fill="currentColor"/></svg>
          </button>
          <button type="button" class="vt__btn" data-fs aria-label="Fullscreen">
            <svg class="i-fs" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7.5V3h4.5M12.5 3H17v4.5M17 12.5V17h-4.5M7.5 17H3v-4.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            <svg class="i-fs-exit" viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 3v4.5H3M17 7.5h-4.5V3M12.5 17v-4.5H17M3 12.5h4.5V17" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <footer class="vt__foot" data-chrome aria-hidden="true">
    <span><kbd>Space</kbd> Play</span><span><kbd>←</kbd><kbd>→</kbd> Seek</span><span><kbd>M</kbd> Mute</span><span><kbd>F</kbd> Fullscreen</span><span><kbd>Esc</kbd> Close</span>
  </footer>
  <p class="visually-hidden" data-live aria-live="polite"></p>
</dialog>

<script>
  // Tiny loader: fetch the player (and warm hls.js + the storyboard) on intent, open on click.
  const dlg = document.querySelector<HTMLDialogElement>('[data-theatre]');
  const triggers = document.querySelectorAll<HTMLElement>('[data-film-open]');
  if (dlg && triggers.length && typeof dlg.showModal === 'function') {
    let player: Promise<{ open(from?: Element | null): void; warm(): void }> | null = null;
    const get = () => (player ??= import('../../scripts/videoTheatre').then((m) => m.createTheatre(dlg)));
    triggers.forEach((t) => {
      const warm = () => get().then((p) => p.warm());
      t.addEventListener('pointerenter', warm, { once: true });
      t.addEventListener('focus', warm, { once: true });
      t.addEventListener('touchstart', warm, { once: true, passive: true });
      t.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let "open in new tab" through
        e.preventDefault();
        get().then((p) => p.open(t.closest('figure')));
      });
    });
  }
</script>

<style>
  /* ---------- shell ---------- */
  .vt { --ui: #fff; --ui-dim: rgb(255 255 255 / .62); --line: rgb(255 255 255 / .18); --ink: #140802;
        position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: clamp(14px, 2.4vw, 32px);
        border: 0; background: transparent; color: var(--ui); overflow: hidden; overscroll-behavior: contain;
        display: none; grid-template-rows: auto 1fr auto; gap: clamp(12px, 2vh, 22px); font-family: var(--font-body); }
  .vt[open] { display: grid; }
  .vt::backdrop { background: transparent; }
  .vt__bg { position: absolute; inset: 0; z-index: -1; background:
            radial-gradient(120% 80% at 50% 45%, rgb(171 66 0 / .22), transparent 60%),
            linear-gradient(rgb(255 255 255 / .035) 1px, transparent 1px) 0 0 / 40px 40px,
            linear-gradient(90deg, rgb(255 255 255 / .035) 1px, transparent 1px) 0 0 / 40px 40px,
            #140802; }
  .vt :global(.vt__ghost) { position: fixed; z-index: 5; pointer-events: none; overflow: hidden; }
  .vt :global(.vt__ghost img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 32%; display: block; }

  /* ---------- top + foot chrome ---------- */
  .vt__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-width: 0; }
  .vt__meta { display: flex; align-items: center; gap: 10px; font-size: 0.8125rem; color: var(--ui-dim); min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vt__meta strong { color: var(--ui); font-weight: 500; }
  .vt__dot { width: 8px; height: 8px; background: var(--brand-tint, #e2b08f); flex: none; animation: vt-blink 2s steps(1) infinite; }
  .vt__sep { opacity: .4; }
  @keyframes vt-blink { 50% { opacity: .25; } }
  .vt__close { display: inline-flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1.2px solid var(--line); color: var(--ui); font-size: 0.8125rem; cursor: pointer;
               transition: background-color .3s, border-color .3s; }
  .vt__close:hover, .vt__close:focus-visible { background: rgb(255 255 255 / .1); border-color: rgb(255 255 255 / .5); }
  .vt__close svg { transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .vt__close:hover svg { transform: rotate(90deg); }
  kbd { font: 500 0.6875rem/1 var(--font-body); padding: 4px 6px; border: 1px solid var(--line); color: var(--ui-dim); }
  .vt__foot { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; font-size: 0.75rem; color: var(--ui-dim); }
  .vt__foot span { display: inline-flex; align-items: center; gap: 6px; }
  @media (hover: none), (max-width: 760px) { .vt__foot { visibility: hidden; } .vt__close kbd { display: none; } }

  /* ---------- stage ---------- */
  .vt__stage { --w: min(100%, calc((100svh - 190px) * 16 / 9), 1600px);
               position: relative; align-self: center; justify-self: center; width: var(--w); aspect-ratio: 16 / 9; background: #000; overflow: hidden; isolation: isolate;
               box-shadow: 0 40px 120px -40px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .06); }
  .vt__stage:fullscreen { width: 100%; height: 100%; aspect-ratio: auto; box-shadow: none; }
  .vt__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: #000; }
  .vt__video::cue { font-family: var(--font-body); font-size: clamp(14px, 1.6vw, 22px); background: rgb(20 8 2 / .82); color: #fff; }
  .vt__hit { position: absolute; inset: 0; z-index: 1; background: none; border: 0; cursor: pointer; }
  .vt__stage.is-idle, .vt__stage.is-idle .vt__hit { cursor: none; }

  .vt__cb { position: absolute; inset: clamp(10px, 1.6vw, 22px); z-index: 2; pointer-events: none; transition: inset .7s cubic-bezier(.16,1,.3,1), opacity .5s; }
  .vt__cb i { position: absolute; width: clamp(18px, 2.4vw, 34px); aspect-ratio: 1; border: 0 solid #fff; }
  .vt__cb i:nth-child(1) { top: 0; left: 0; border-width: 2px 0 0 2px; }
  .vt__cb i:nth-child(2) { top: 0; right: 0; border-width: 2px 2px 0 0; }
  .vt__cb i:nth-child(3) { bottom: 0; left: 0; border-width: 0 0 2px 2px; }
  .vt__cb i:nth-child(4) { bottom: 0; right: 0; border-width: 0 2px 2px 0; }
  .vt__stage.is-playing:not(.is-ui) .vt__cb { opacity: 0; inset: 0; }

  /* big play: the hero's frosted disc + rings, so the photo → player hand-off feels continuous */
  .vt__big { --d: clamp(72px, 8vw, 120px); position: absolute; z-index: 3; left: 50%; top: 50%; width: var(--d); height: var(--d); margin: calc(var(--d) / -2) 0 0 calc(var(--d) / -2);
             display: grid; place-items: center; border-radius: 50%; color: #fff; cursor: pointer; transition: opacity .35s, transform .6s cubic-bezier(.16,1,.3,1); }
  .vt__big svg { position: relative; width: 32%; margin-left: 8%; }
  .vt__disc { position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / .65); background: rgb(255 255 255 / .1);
              -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: transform .6s cubic-bezier(.16,1,.3,1), background-color .3s; }
  .vt__big:hover .vt__disc { transform: scale(1.06); background: rgb(255 255 255 / .18); }
  .vt__ring { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgb(255 255 255 / .6); opacity: 0; animation: vt-ripple 3.2s cubic-bezier(.22,.61,.36,1) infinite; }
  .vt__ring + .vt__ring { animation-delay: 1.6s; }
  @keyframes vt-ripple { 0% { transform: scale(1); opacity: 0; } 10% { opacity: .7; } 100% { transform: scale(2.1); opacity: 0; } }
  .vt__stage.is-playing .vt__big, .vt__stage.is-ended .vt__big, .vt__stage.is-loading .vt__big { opacity: 0; transform: scale(.85); pointer-events: none; }

  .vt__pulse { position: absolute; z-index: 3; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; display: grid; place-items: center;
               background: rgb(20 8 2 / .45); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); opacity: 0; pointer-events: none; }
  .vt__pulse :global(svg) { width: 28px; height: 28px; color: #fff; }
  .vt__pulse.is-on { animation: vt-pulse .65s cubic-bezier(.16,1,.3,1); }
  @keyframes vt-pulse { 0% { opacity: 1; transform: scale(.8); } 100% { opacity: 0; transform: scale(1.35); } }

  .vt__spin { position: absolute; z-index: 3; left: 50%; top: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; opacity: 0; transition: opacity .3s; pointer-events: none; }
  .vt__spin i { background: #fff; animation: vt-spin 1.1s cubic-bezier(.65,0,.35,1) infinite; }
  .vt__spin i:nth-child(2) { animation-delay: .14s; } .vt__spin i:nth-child(4) { animation-delay: .28s; } .vt__spin i:nth-child(3) { animation-delay: .42s; }
  @keyframes vt-spin { 0%, 100% { opacity: .2; transform: scale(.6); } 40% { opacity: 1; transform: scale(1); } }
  .vt__stage.is-buffering .vt__spin { opacity: 1; }

  .vt__flash { position: absolute; z-index: 3; left: 50%; top: 18%; transform: translateX(-50%); padding: 9px 14px; background: var(--brand); color: #fff; font-size: 0.8125rem; font-weight: 500;
               opacity: 0; pointer-events: none; white-space: nowrap; }
  .vt__flash.is-on { animation: vt-flash 1s cubic-bezier(.16,1,.3,1); }
  @keyframes vt-flash { 0% { opacity: 0; transform: translate(-50%, 8px); } 15%, 70% { opacity: 1; transform: translate(-50%, 0); } 100% { opacity: 0; } }

  .vt__unmute { position: absolute; z-index: 4; left: clamp(14px, 2vw, 28px); top: clamp(14px, 2vw, 28px); display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px;
                background: #fff; color: var(--brand); font-size: 0.8125rem; font-weight: 500; cursor: pointer; }

  /* end screen */
  .vt__end { position: absolute; inset: 0; z-index: 4; display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center; padding: 24px;
             background: rgb(20 8 2 / .72); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); animation: vt-in .8s cubic-bezier(.16,1,.3,1); }
  .vt__end[hidden] { display: none; }
  .vt__end-eyebrow { font-size: 0.8125rem; color: var(--ui-dim); }
  .vt__end-title { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.4rem); line-height: 1.1; letter-spacing: var(--track-xl); word-spacing: var(--words-xl); }
  .vt__end-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 10px; }
  .vt__cta, .vt__ghost-btn { display: inline-flex; align-items: center; gap: 10px; padding: 15px 22px; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
  .vt__cta { background: #fff; color: var(--brand); }
  .vt__cta span { transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .vt__cta:hover span { transform: translateX(5px); }
  .vt__ghost-btn { border: 1.2px solid rgb(255 255 255 / .45); color: #fff; }
  .vt__ghost-btn:hover { background: rgb(255 255 255 / .1); }
  @keyframes vt-in { from { opacity: 0; } }

  /* ---------- control deck ---------- */
  .vt__ui { position: absolute; z-index: 5; left: 0; right: 0; bottom: 0; padding: 48px clamp(12px, 1.8vw, 24px) clamp(10px, 1.4vw, 18px);
            background: linear-gradient(to top, rgb(20 8 2 / .86), rgb(20 8 2 / .45) 55%, transparent); transition: opacity .45s, transform .6s cubic-bezier(.16,1,.3,1); }
  .vt__stage:not(.is-ui) .vt__ui { opacity: 0; transform: translateY(10px); pointer-events: none; }
  .vt__stage.is-ended .vt__ui { opacity: 0; pointer-events: none; }

  .vt__scrub { position: relative; height: 22px; display: flex; align-items: center; cursor: pointer; touch-action: none; outline: none; }
  .vt__track { position: relative; width: 100%; height: 3px; background: rgb(255 255 255 / .22); transition: height .25s cubic-bezier(.16,1,.3,1); overflow: hidden; }
  .vt__scrub:hover .vt__track, .vt__scrub.is-drag .vt__track, .vt__scrub:focus-visible .vt__track { height: 6px; }
  .vt__buf, .vt__hover, .vt__fill { position: absolute; inset: 0 auto 0 0; width: 0; }
  .vt__buf { background: rgb(255 255 255 / .3); }
  .vt__hover { background: rgb(255 255 255 / .28); opacity: 0; transition: opacity .2s; }
  .vt__scrub:hover .vt__hover { opacity: 1; }
  .vt__fill { background: #fff; }
  .vt__head { position: absolute; left: 0; top: 50%; width: 12px; height: 12px; margin: -6px 0 0 -6px; background: var(--brand); border: 2px solid #fff;
              transform: scale(0); transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
  .vt__scrub:hover .vt__head, .vt__scrub.is-drag .vt__head, .vt__scrub:focus-visible .vt__head { transform: scale(1); }
  .vt__scrub:focus-visible { box-shadow: 0 0 0 0 transparent; }
  .vt__scrub:focus-visible .vt__track { outline: 2px solid rgb(255 255 255 / .5); outline-offset: 3px; }
  .vt__tip { position: absolute; bottom: 26px; left: 0; display: grid; justify-items: center; gap: 6px; transform: translateX(-50%) translateY(6px); opacity: 0; pointer-events: none;
             transition: opacity .2s, transform .35s cubic-bezier(.16,1,.3,1); }
  .vt__scrub:hover .vt__tip, .vt__scrub.is-drag .vt__tip { opacity: 1; transform: translateX(-50%) translateY(0); }
  .vt__thumb { width: 176px; aspect-ratio: 16 / 9; background: #000 no-repeat; border: 1.5px solid #fff; box-shadow: 0 12px 30px rgb(0 0 0 / .45); }
  .vt__thumb:not(.has-img) { display: none; }
  .vt__tiptime { padding: 6px 9px; background: var(--brand); color: #fff; font-size: 0.75rem; font-weight: 500; font-variant-numeric: tabular-nums; }

  .vt__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 4px; }
  .vt__group { display: flex; align-items: center; gap: 2px; min-width: 0; }
  .vt__btn { position: relative; display: grid; place-items: center; width: 40px; height: 40px; color: #fff; cursor: pointer; transition: background-color .25s, transform .4s cubic-bezier(.34,1.56,.64,1); }
  .vt__btn svg { width: 20px; height: 20px; }
  .vt__btn--sm svg { width: 19px; height: 19px; }
  .vt__btn--text { width: auto; min-width: 40px; padding: 0 10px; white-space: nowrap; font-size: 0.78rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .vt__btn:hover, .vt__btn[aria-expanded='true'] { background: rgb(255 255 255 / .12); }
  .vt__btn:active { transform: scale(.9); }
  .vt__btn:focus-visible, .vt__big:focus-visible, .vt__close:focus-visible, .vt__cta:focus-visible, .vt__ghost-btn:focus-visible, .vt__unmute:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .vt__btn[aria-pressed='true'] { background: #fff; color: var(--brand); }
