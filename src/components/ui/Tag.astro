---
const { label, tone = 'light' } = Astro.props as { label: string; tone?: 'light' | 'on-brand' };
---
<li class:list={['tag', `tag--${tone}`]}>{label}</li>
<style>
  .tag { font-weight: 500; font-size: var(--fs-xs); line-height: 1.3; padding: 5px 9px; border: 1px solid var(--line); background: var(--white); color: var(--brand); }
  .tag--on-brand { background: rgb(255 255 255 / .1); border-color: rgb(255 255 255 / .35); color: var(--white); }
</style>
