---
/** Stock portrait with the brand duotone treatment (grayscale + colour-blend overlay). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const avatars = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/avatar-*.jpg', { eager: true });
export interface Props { index: number; size?: number; shape?: 'square' | 'circle'; alt?: string; ring?: boolean; class?: string }
const { index, size = 28, shape = 'square', alt = '', ring = false, class: cls } = Astro.props;
const src = avatars[`../../assets/images/avatar-0${index}.jpg`]?.default;
---
<span class:list={['avatar', 'duotone', `avatar--${shape}`, ring && 'avatar--ring', cls]} style={`--s:${size}px`}>
  {src && <Image src={src} alt={alt} width={size * 2} height={size * 2} loading="lazy" decoding="async" />}
</span>
<style>
  .avatar { width: var(--s); height: var(--s); flex: none; display: inline-block; }
  .avatar--circle, .avatar--circle :global(img) { border-radius: 50%; }
  .avatar--ring { box-shadow: 0 0 0 1.5px var(--white); }
  .avatar :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
